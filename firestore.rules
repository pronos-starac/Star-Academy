rules_version = '2';

// Règles de sécurité Firestore du site de pronostics.
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
// Seul le joueur « aurelien » (pseudo + code) est organisateur, sur n'importe quel appareil.
//
// VERSION 16 — 27/10/2026 : réponses aux avis des chansons de l'onglet Prime (collection songreplies).
// VERSION 15 — 27/10/2026 : réponses aux commentaires des quotidiennes (champ optionnel « parent »).
// VERSION 14 — 17/10/2026 : emoji 🍅 (tomato) sur les chansons de l'onglet Prime.
// VERSION 13 — 17/10/2026 : option anti-spoiler du dimanche (noSun) enregistrée dans les préférences de notification.
// VERSION 12 — 15/10/2026 : option anti-spoiler des nominés enregistrée dans les préférences de notification.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'aurelien@pronos-star-ac.firebaseapp.com'; }
    function isPlayer() { return signedIn() && exists(/databases/$(database)/documents/players/$(request.auth.uid)); }
    function season() { return get(/databases/$(database)/documents/season/main).data; }

    // Résultats de la saison : lisibles par tous, modifiables par l'organisateur uniquement.
    match /season/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Un document par joueur : pseudo + classement final.
    // Chacun ne modifie que le sien. Classement figé quand l'organisateur verrouille.
    match /players/{uid} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.order is list
        && request.resource.data.order.size() <= 17
        && (season().rankingOpen == true
            || (resource == null
                  ? request.resource.data.order.size() == 0
                  : request.resource.data.order == resource.data.order));
    }

    // Choix de la semaine (éliminé, immunisé) : un document par joueur et par semaine,
    // refusé après l'heure de fermeture de la semaine.
    match /picks/{pickId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.week is int
        && pickId == string(request.resource.data.week) + '_' + request.auth.uid
        && request.time < season().locks[string(request.resource.data.week)];
    }


    // Réactions emoji aux quotidiennes : un document par joueur et par quotidienne.
    match /reactions/{rid} {
      allow read: if true;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isPlayer()
        && request.resource.data.keys().hasOnly(['uid', 'recap', 'e'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.recap is string
        && request.resource.data.recap.size() == 10
        && rid == request.resource.data.recap + '_' + request.auth.uid
        && request.resource.data.e is list
        && request.resource.data.e.size() <= 6
        && request.resource.data.e.hasOnly(['love', 'lol', 'wow', 'sad', 'fire', 'clap']);
    }

    // Commentaires sur les quotidiennes : on publie et on supprime les siens, l'organisateur supprime tout.
    match /comments/{cid} {
      allow read: if true;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if false;
      allow create: if isPlayer()
        && request.resource.data.keys().hasOnly(['uid', 'recap', 'text', 'at', 'parent'])
        && request.resource.data.uid == request.auth.uid
        && cid.matches(request.auth.uid + '_[0-9]+')
        && request.resource.data.recap is string
        && request.resource.data.recap.size() == 10
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.at == request.time
        // réponse : « parent » est l'identifiant du commentaire auquel on répond
        && (!('parent' in request.resource.data)
            || (request.resource.data.parent is string
                && request.resource.data.parent.matches('[A-Za-z0-9]+_[0-9]+')));
    }

    // Cœurs & tomates : jusqu'à 3 de chaque par joueur et par semaine, modifiables jusqu'à dimanche minuit.
    match /likes/{lid} {
      allow read: if true;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.time < season().locks[string(resource.data.week)]);
      allow create, update: if isPlayer()
        && request.resource.data.keys().hasOnly(['uid', 'week', 'up', 'down'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.week is int
        && lid == string(request.resource.data.week) + '_' + request.auth.uid
        && request.resource.data.up is list && request.resource.data.up.size() <= 3
        && request.resource.data.down is list && request.resource.data.down.size() <= (request.resource.data.week == 1 ? 4 : 3)
        && request.resource.data.up.hasOnly(['amel','antoine','brieuc','cameron','elija','felix','isabella','khalil','kylian','leeloo','maud','melina','morgan','noemie','tracy','ydriss','zoe'])
        && request.resource.data.down.hasOnly(['amel','antoine','brieuc','cameron','elija','felix','isabella','khalil','kylian','leeloo','maud','melina','morgan','noemie','tracy','ydriss','zoe'])
        && request.time < season().locks[string(request.resource.data.week)];
    }

    // Option « mes votes sont anonymes » de chaque joueur.
    match /likeprefs/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['anon'])
        && request.resource.data.anon is bool;
    }

    // Jetons de notification : un document par appareil. Lu uniquement par le robot d'envoi (droits admin).
    match /pushTokens/{token} {
      allow read: if false;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Préférences de notification de chaque joueur (lues par le robot d'envoi avec les droits admin).
    match /notifprefs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['prime', 'thread', 'all', 'noNom', 'noSun'])
        && request.resource.data.prime is bool
        && request.resource.data.thread is bool
        && request.resource.data.all is bool
        && (!('noNom' in request.resource.data) || request.resource.data.noNom is bool)
        && (!('noSun' in request.resource.data) || request.resource.data.noSun is bool);
    }

    // Présence : dernière visite de chaque joueur (pour « X en ligne »).
    match /presence/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }

    // Onglet Prime : chat en direct.
    match /primechat/{mid} {
      allow read: if true;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if false;
      allow create: if isPlayer()
        && request.resource.data.keys().hasOnly(['uid', 'prime', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && mid.matches(request.auth.uid + '_[0-9]+')
        && request.resource.data.prime is int
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.at == request.time;
    }

    // Onglet Prime : chansons ajoutées par les joueurs.
    match /songs/{sid} {
      allow read: if true;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if false;
      allow create: if isPlayer()
        && request.resource.data.keys().hasOnly(['uid', 'prime', 'title', 'eleves', 'at', 'cover'])
        && (!('cover' in request.resource.data) || (request.resource.data.cover is string && request.resource.data.cover.size() <= 300 && request.resource.data.cover.matches('https://.*')))
        && request.resource.data.uid == request.auth.uid
        && sid.matches(request.auth.uid + '_[0-9]+')
        && request.resource.data.prime is int
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.eleves is list && request.resource.data.eleves.size() <= 4
        && request.resource.data.eleves.hasOnly(['amel','antoine','brieuc','cameron','elija','felix','isabella','khalil','kylian','leeloo','maud','melina','morgan','noemie','tracy','ydriss','zoe'])
        && request.resource.data.at == request.time;
    }

    // Onglet Prime : note sur 10, emojis et avis de chaque joueur sur une chanson.
    match /songratings/{rid} {
      allow read: if true;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isPlayer()
        && request.resource.data.keys().hasOnly(['uid', 'song', 'prime', 'note', 'e', 'text'])
        && request.resource.data.uid == request.auth.uid
        && rid == request.resource.data.song + '_' + request.auth.uid
        && request.resource.data.prime is int
        && (request.resource.data.note == null
            || (request.resource.data.note is int && request.resource.data.note >= 1 && request.resource.data.note <= 10))
        && request.resource.data.e is list && request.resource.data.e.size() <= 5
        && request.resource.data.e.hasOnly(['fire', 'up', 'meh', 'down', 'tomato'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 200;
    }

    // Onglet Prime : réponses aux avis des chansons (« parent » = identifiant de l'avis, chanson_joueur).
    match /songreplies/{rid} {
      allow read: if true;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if false;
      allow create: if isPlayer()
        && request.resource.data.keys().hasOnly(['uid', 'prime', 'song', 'parent', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && rid.matches(request.auth.uid + '_[0-9]+')
        && request.resource.data.prime is int
        && request.resource.data.song is string
        && request.resource.data.song.matches('[A-Za-z0-9]+_[0-9]+')
        && request.resource.data.parent is string
        && request.resource.data.parent.matches(request.resource.data.song + '_[A-Za-z0-9]+')
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.at == request.time;
    }
  }
}
